# ============================================
# Complaint Management System
# Root Git Ignore
# ============================================

# Environment / secrets
.env
.env.*
!.env.example

# Laravel
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/app/
backend/storage/framework/
backend/storage/logs/
backend/bootstrap/cache/
backend/public/build/

# React / Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
